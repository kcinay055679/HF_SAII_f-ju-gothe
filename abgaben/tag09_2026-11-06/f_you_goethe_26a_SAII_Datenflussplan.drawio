h=2;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#DC2626;fontColor=#7F1D1D;dashed=1;exitX=0.25;exitY=0;entryX=1;entryY=0.85;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1295" y="765"/><mxPoint x="1228" y="765"/><mxPoint x="1228" y="435"/></Array></mxGeometry></mxCell><mxCell id="c57" parent="1" vertex="1" value="&lt;b&gt;Legende&lt;/b&gt;&lt;br&gt;&lt;font color='#1E293B'&gt;■&lt;/font&gt; Release: Code → Image → Deployment (①–⑦)&lt;br&gt;&lt;font color='#A16207'&gt;■&lt;/font&gt; Anwendung: Ⓐ Login (Name + Passwort) · Ⓑ Stempeln (EIN / PAUSE / ZURÜCK / AUS) · Ⓒ Adminbereich (alle Stempelungen)&lt;br&gt;&lt;font color='#16A34A'&gt;■&lt;/font&gt; Monitoring: Ⓜ1 Prometheus holt Metriken (Pull) · Ⓜ2 Logs → Elasticsearch · Ⓜ3 Grafana fragt Prometheus ab&lt;br&gt;&lt;font color='#7C3AED'&gt;■&lt;/font&gt; Alarmierung: Ⓜ4 Regel feuert → Alertmanager · Ⓜ5 Nachricht an Mattermost, später «resolved»&lt;br&gt;&lt;font color='#DC2626'&gt;- -&lt;/font&gt; Tests von Kali &amp;nbsp;·&amp;nbsp; Speicherorte: Code + Manifeste in Git, Images in der Registry, Stempelungen im PVC" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#64748B;fontFamily=Arial;fontSize=12;"><mxGeometry x="40" y="955" width="840" height="140" as="geometry"/></mxCell><mxCell id="c58" parent="1" vertex="1" value="&lt;b&gt;Offene Annahmen (*)&lt;/b&gt;&lt;br&gt;· HTTPS 443 von lan0 nach dmz0 noch ungetestet (SSH und Ping geprüft)&lt;br&gt;· CI-Produkt und Registry noch offen (z. B. GitHub Actions + GHCR)&lt;br&gt;· Mattermost auf LM2 oder zentral bereitgestellt · Logs mit ELK oder Loki (RAM auf LM2)&lt;br&gt;· Datenbank: geplant PostgreSQL, App v1.4 nutzt noch SQLite · Container-Port 8080 (ADR-0006, vorher 5000)" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fillColor=#FFFBEB;strokeColor=#CA8A04;fontFamily=Arial;fontSize=12;"><mxGeometry x="900" y="955" width="860" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>