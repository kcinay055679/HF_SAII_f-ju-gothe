ue="Namespace &lt;b&gt;argocd&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="1427" y="694" width="301" height="30" as="geometry"/></mxCell><mxCell id="k47" value="&lt;b&gt;Argo CD&lt;/b&gt;&lt;br&gt;liest &lt;code&gt;deploy/&lt;/code&gt; aus GitHub, Sync + Health" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=2;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#0F172A;fillColor=#EDE9FE;strokeColor=#7C3AED;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1430" y="726" width="295" height="72" as="geometry"/></mxCell><mxCell id="k48" value="&lt;b&gt;GitHub&lt;/b&gt; SAII_Zeiterfassung&lt;br&gt;Code, IaC · CI* · Registry GHCR*" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=2;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#0F172A;fillColor=#F1F5F9;strokeColor=#475569;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="830" width="320" height="70" as="geometry"/></mxCell><mxCell id="k49" value="&lt;b&gt;Mattermost*&lt;/b&gt;&lt;br&gt;Alarm firing / resolved" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=2;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#0F172A;fillColor=#EDE9FE;strokeColor=#7C3AED;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1420" y="830" width="320" height="70" as="geometry"/></mxCell><mxCell id="k50" value="Unterschied zum Ist: PostgreSQL statt SQLite, Alertmanager + Mattermost, Logs zentral, kein direkter Port ausser 443, Deployment nur über Git (GitOps)." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="1080" y="912" width="660" height="60" as="geometry"/></mxCell><mxCell id="k51" value=