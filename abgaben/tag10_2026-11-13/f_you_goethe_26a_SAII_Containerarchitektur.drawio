<mxfile host="app.diagrams.net"><diagram name="Container-Architektur (Tag 10)" id="ca1"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1110" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="k2" value="" style="rounded=1;html=1;fillColor=#0F172A;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1720" height="74" as="geometry"/></mxCell><mxCell id="k3" value="&lt;b&gt;CONTAINER-ARCHITEKTUR | SAII – Zeiterfassung&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=26;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="64" y="39" width="1600" height="50" as="geometry"/></mxCell><mxCell id="k4" value="Team f_you_goethe · 26a · Stand 13.11.2026 · links: Ist-Zustand auf LM2 (Tag 10, läuft) · rechts: Zielbild auf Kubernetes · &lt;i&gt;* = Annahme&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="1700" height="30" as="geometry"/></mxCell><mxCell id="k5" value="" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="1000" height="830" as="geometry"/></mxCell><mxCell id="k6" value="&lt;b&gt;IST · LM2 · li264-vmLM2 · 192.168.120.60&lt;/b&gt; · Ubuntu 26.04 · 1 vCPU · 15 GiB · Docker 29.1.3 + Compose" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="52" y="154" width="976" height="30" as="geometry"/></mxCell><mxCell id="k7" value="Ein Befehl startet alles aus dem App-Repo: &lt;code&gt;git clone …/SAII_Zeiterfassung &amp;&amp; make up&lt;/code&gt; (Tests, dann &lt;code&gt;docker compose up -d --build&lt;/code&gt;). Compose-Projekt &lt;b&gt;zeiterfassung&lt;/b&gt;." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=12;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="60" y="186" width="960" height="40" as="geometry"/></mxCell><mxCell id="k8" value="&lt;b&gt;Veröffentlichte Ports auf LM2&lt;/b&gt; (aus lan0 erreichbar, geprüft 13.11.): 8080 Zeiterfassung · 9090 Prometheus · 9100 Node Exporter · 3000 Grafana" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=2;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#0F172A;fillColor=#F1F5F9;strokeColor=#475569;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="232" width="960" height="44" as="geometry"/></mxCell><mxCell id="k9" value="" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="60" y="292" width="960" height="420" as="geometry"/></mxCell><mxCell id="k10" value="&lt;b&gt;Docker-Netz&lt;/b&gt; zeiterfassung_default (Bridge) · Container finden sich über den Service-Namen" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="72" y="296" width="936" height="30" as="geometry"/></mxCell><mxCell id="k11" value="&lt;b&gt;zeiterfassung&lt;/b&gt; · Image &lt;code&gt;zeiterfassung:1.5&lt;/code&gt;&lt;br&gt;aus &lt;code&gt;app/&lt;/code&gt; gebaut (python:3.13-slim, per Digest), läuft als UID 10001&lt;br&gt;gunicorn, 1 Worker, 8 Threads · &lt;b&gt;:8080&lt;/b&gt;&lt;br&gt;/ · /person · /stamp · /board · /events&lt;br&gt;/health (Healthcheck alle 15 s) · &lt;b&gt;/metrics&lt;/b&gt;&lt;br&gt;Logs: Access-Log auf stdout · RAM ≈ 47 MiB" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=2;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#0F172A;fillColor=#FEF08A;strokeColor=#A16207;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="340" width="420" height="165" as="geometry"/></mxCell><mxCell id="k12" value="&lt;b&gt;prometheus&lt;/b&gt; · &lt;code&gt;prom/prometheus:v3.5.0&lt;/code&gt; · &lt;b&gt;:9090&lt;/b&gt;&lt;br&gt;holt alle 15 s Metriken (Pull):&lt;br&gt;· zeiterfassung:8080/metrics&lt;br&gt;· node-exporter:9100/metrics · sich selbst&lt;br&gt;bewertet 7 Alert-Regeln · RAM ≈ 25 MiB" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=2;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#0F172A;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="340" width="420" height="165" as="geometry"/></mxCell><mxCell id="k13" value="&lt;b&gt;grafana&lt;/b&gt; · &lt;code&gt;grafana/grafana:12.0.2&lt;/code&gt; · &lt;b&gt;:3000&lt;/b&gt;&lt;br&gt;Datenquelle Prometheus und Dashboard&lt;br&gt;«LM2 und Zeiterfassung» automatisch provisioniert&lt;br&gt;Login admin / saii-demo (nur Schulung)&lt;br&gt;RAM ≈ 91 MiB" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=2;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#0F172A;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="530" width="420" height="160" as="geometry"/></mxCell><mxCell id="k14" value="&lt;b&gt;node-exporter&lt;/b&gt; · &lt;code&gt;prom/node-exporter:v1.9.1&lt;/code&gt; · &lt;b&gt;:9100&lt;/b&gt;&lt;br&gt;liest CPU, RAM, Dateisystem, Netzwerk von LM2&lt;br&gt;Host &lt;code&gt;/proc&lt;/code&gt;, &lt;code&gt;/sys&lt;/code&gt;, &lt;code&gt;/&lt;/code&gt; read-only eingebunden&lt;br&gt;no-new-privileges · RAM ≈ 7 MiB" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=2;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#0F172A;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="530" width="420" height="160" as="geometry"/></mxCell><mxCell id="k15" value="scrape" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#16A34A;fontFamily=Arial;fontSize=11;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0;exitY=0.35;entryX=1;entryY=0.35;" edge="1" parent="1" source="k12" target="k11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k16" value="scrape" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#16A34A;fontFamily=Arial;fontSize=11;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0;exitY=0.85;entryX=1;entryY=0.3;" edge="1" parent="1" source="k12" target="k14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k17" value="PromQL :9090" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#16A34A;fontFamily=Arial;fontSize=11;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="k13" target="k12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k18" value="&lt;b&gt;Volumes&lt;/b&gt; (Daten überleben Neustart und Update) · &lt;b&gt;Bind-Mounts&lt;/b&gt; (Konfiguration aus Git, read-only)" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="80" y="728" width="940" height="24" as="geometry"/></mxCell><mxCell id="k19" value="&lt;b&gt;zeiterfassung-data&lt;/b&gt; → /data&lt;br&gt;SQLite-Datenbank der Stamps" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=2;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#0F172A;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="758" width="300" height="62" as="geometry"/></mxCell><mxCell id="k20" value="&lt;b&gt;prometheus-data&lt;/b&gt; → /prometheus&lt;br&gt;Zeitreihen (Standard 15 Tage)" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=2;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#0F172A;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="758" width="300" height="62" as="geometry"/></mxCell><mxCell id="k21" value="&lt;b&gt;grafana-data&lt;/b&gt; → /var/lib/grafana&lt;br&gt;Grafana-Einstellungen" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=2;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#0F172A;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="758" width="300" height="62" as="geometry"/></mxCell><mxCell id="k22" value="&lt;code&gt;monitoring/prometheus/prometheus.yml&lt;/code&gt;, &lt;code&gt;alerts.yml&lt;/code&gt;&lt;br&gt;→ prometheus (Scrape-Ziele, Alert-Regeln)" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=2;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#0F172A;fillColor=#F1F5F9;strokeColor=#475569;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="838" width="460" height="62" as="geometry"/></mxCell><mxCell id="k23" value="&lt;code&gt;monitoring/grafana/provisioning&lt;/code&gt;, &lt;code&gt;dashboards&lt;/code&gt;&lt;br&gt;→ grafana (Datenquelle, Dashboard als JSON)" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=2;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#0F172A;fillColor=#F1F5F9;strokeColor=#475569;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="838" width="460" height="62" as="geometry"/></mxCell><mxCell id="k24" value="Prinzipien: ein Prozess pro Container · feste Image-Versionen (kein &lt;code&gt;latest&lt;/code&gt;) · Konfiguration nur aus Git · Daten nur in Volumes · Logs nur auf stdout · &lt;code&gt;restart: unless-stopped&lt;/code&gt;. Summe RAM aller Container ≈ 170 MiB, CPU im Ruhezustand &amp;lt; 1 %." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="80" y="912" width="940" height="60" as="geometry"/></mxCell><mxCell id="k25" value="&lt;b&gt;Person / Admin (Browser)&lt;/b&gt;&lt;br&gt;Stempeln :8080 · Grafana :3000&lt;br&gt;über lan0 → LF1 → dmz0" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=2;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#0F172A;fillColor=#F1F5F9;strokeColor=#475569;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="160" width="300" height="70" as="geometry"/></mxCell><mxCell id="k26" value="&lt;b&gt;Kali KL1 / KL2&lt;/b&gt;&lt;br&gt;GUI-, Funktions-, Sicherheitstests&lt;br&gt;heute auf :8080, Ziel nur über 443" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=2;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#0F172A;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1400" y="160" width="340" height="70" as="geometry"/></mxCell><mxCell id="k27" value="" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;fillColor=#FAF5FF;strokeColor=#7C3AED;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1060" y="250" width="700" height="730" as="geometry"/></mxCell><mxCell id="k28" value="&lt;b&gt;ZIEL · Kubernetes (k3s*) auf LM2&lt;/b&gt; · verteilt durch Argo CD aus &lt;code&gt;deploy/&lt;/code&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="1072" y="254" width="676" height="30" as="geometry"/></mxCell><mxCell id="k29" value="&lt;b&gt;Ingress (Traefik)&lt;/b&gt; · nur HTTPS 443 von aussen, TLS* · alle anderen Ports ClusterIP" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=2;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#0F172A;fillColor=#F1F5F9;strokeColor=#475569;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="296" width="660" height="48" as="geometry"/></mxCell><mxCell id="k30" value="" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#A16207;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1080" y="360" width="660" height="130" as="geometry"/></mxCell><mxCell id="k31" value="Namespace &lt;b&gt;zeiterfassung&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="1092" y="364" width="636" height="30" as="geometry"/></mxCell><mxCell id="k32" value="&lt;b&gt;zeiterfassung&lt;/b&gt; Deployment&lt;br&gt;3 Replicas · :8080 · /metrics&lt;br&gt;JSON-Logs auf stdout" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=2;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#0F172A;fillColor=#FEF08A;strokeColor=#A16207;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1095" y="396" width="310" height="82" as="geometry"/></mxCell><mxCell id="k33" value="&lt;b&gt;PostgreSQL&lt;/b&gt; StatefulSet + PVC&lt;br&gt;:5432 nur intern · Secret&lt;br&gt;postgres_exporter*" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=2;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#0F172A;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1420" y="396" width="305" height="82" as="geometry"/></mxCell><mxCell id="k34" value="" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1080" y="500" width="660" height="180" as="geometry"/></mxCell><mxCell id="k35" value="Namespace &lt;b&gt;monitoring&lt;/b&gt; (kube-prometheus-stack*)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="1092" y="504" width="636" height="30" as="geometry"/></mxCell><mxCell id="k36" value="&lt;b&gt;Prometheus&lt;/b&gt;&lt;br&gt;PrometheusRules" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=2;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#0F172A;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1095" y="536" width="205" height="62" as="geometry"/></mxCell><mxCell id="k37" value="&lt;b&gt;Alertmanager&lt;/b&gt;&lt;br&gt;:9093 → Mattermost" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=2;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#0F172A;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1310" y="536" width="205" height="62" as="geometry"/></mxCell><mxCell id="k38" value="&lt;b&gt;Grafana&lt;/b&gt;&lt;br&gt;Dashboards als ConfigMap" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=2;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#0F172A;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1525" y="536" width="200" height="62" as="geometry"/></mxCell><mxCell id="k39" value="&lt;b&gt;Node Exporter&lt;/b&gt;&lt;br&gt;DaemonSet" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=2;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#0F172A;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1095" y="606" width="205" height="62" as="geometry"/></mxCell><mxCell id="k40" value="&lt